From 18275303acb2eabcb969b2cef260b82723540915 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Mon, 26 Oct 2026 17:04:32 +0300
Subject: [PATCH 1/2] panvk: fix Eden crash and GPU faults on Mali-G72 (Bifrost
 v6)

- Size push descriptor storage for combined image samplers, which take
  textures_per_desc + samplers_per_desc slots each. maxPushDescriptors (32)
  combined samplers overflowed the 32-slot push set and the meta save
  buffer (SIGSEGV in meta_gfx_end from vkCmdClearAttachments).
- Give the Bifrost null texture its own table of 256 surfaces that read the
  zero buffer. Sampling a null binding as an array/cube indexed past the
  single surface of the 1x1 view and faulted (DATA_INVALID_FAULT 0x58).
- Read KEY=VALUE lines from panvk.env next to the driver, for loaders that
  give no way to set environment variables.
- Dump the faulting job, its payload pointers and the memory around the
  fault address when a kbase submission fails.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c   | 55 +++++++++++++++
 src/panfrost/vulkan/panvk_cmd_desc_state.h    |  2 +-
 src/panfrost/vulkan/panvk_cmd_meta.h          |  4 +-
 .../vulkan/panvk_descriptor_set_layout.h      |  4 ++
 src/panfrost/vulkan/panvk_device.h            |  2 +
 src/panfrost/vulkan/panvk_instance.c          | 42 +++++++++++
 src/panfrost/vulkan/panvk_vX_device.c         | 69 +++++++++++++++++++
 7 files changed, 175 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 9a3c4d1..c459f3d 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -29,6 +29,9 @@
 #include "vk_drm_syncobj.h"
 #include "vk_framebuffer.h"
 
+#include <stdio.h>
+#include <unistd.h>
+
 #include "kmod/pan_kmod.h"
 
 #include "drm-uapi/panfrost_drm.h"
@@ -76,6 +79,46 @@ panvk_queue_prepare_batch(struct panvk_device *dev, struct panvk_cmd_buffer *cmd
  * job header's exception status (word 0) and fault pointer (words 2-3) back when the job ends,
  * and leaves 0 in the ones it never ran -- that is how the TLS overrun on the Mali-G52 was found
  * (the first job after the last DONE one was the spilling kernel). */
+/* Read GPU memory through its CPU mapping (kbase maps BOs at the same VA on
+ * both sides), without faulting if the address is not mapped. */
+static bool
+panvk_peek(uint64_t va, void *dst, size_t size)
+{
+   FILE *f = fopen("/proc/self/maps", "r");
+   if (!f)
+      return false;
+   char line[512];
+   bool ok = false;
+   while (fgets(line, sizeof(line), f)) {
+      unsigned long long lo, hi;
+      char perms[5];
+      if (sscanf(line, "%llx-%llx %4s", &lo, &hi, perms) == 3 && va >= lo &&
+          va + size <= hi && perms[0] == 'r') {
+         ok = true;
+         break;
+      }
+   }
+   fclose(f);
+   if (ok)
+      memcpy(dst, (const void *)(uintptr_t)va, size);
+   return ok;
+}
+
+static void
+panvk_dump_words(const char *what, uint64_t va, unsigned count)
+{
+   uint32_t w[64];
+   count = MIN2(count, ARRAY_SIZE(w));
+   if (!va || !panvk_peek(va, w, count * 4)) {
+      mesa_loge("panvk:   %s @0x%" PRIx64 ": unreadable", what, va);
+      return;
+   }
+   for (unsigned i = 0; i < count; i += 8)
+      mesa_loge("panvk:   %s @0x%" PRIx64 "+0x%02x: %08x %08x %08x %08x %08x %08x %08x %08x",
+                what, va, i * 4, w[i], w[i + 1], w[i + 2], w[i + 3], w[i + 4], w[i + 5],
+                w[i + 6], w[i + 7]);
+}
+
 static void
 panvk_kbase_report_faults(struct panvk_device *dev, struct panvk_cmd_buffer *const *cmdbufs,
                           unsigned nr_cmdbufs)
@@ -90,6 +133,18 @@ panvk_kbase_report_faults(struct panvk_device *dev, struct panvk_cmd_buffer *con
             mesa_loge("panvk: batch %u job %u: status 0x%x type %u index %u deps %u,%u "
                       "fault 0x%" PRIx64, b, k, w[0], (w[4] >> 1) & 0x7f, w[4] >> 16,
                       w[5] & 0xffff, w[5] >> 16, (uint64_t)w[2] | ((uint64_t)w[3] << 32));
+            if (w[0] > 1) {
+               uint64_t fault = (uint64_t)w[2] | ((uint64_t)w[3] << 32);
+               panvk_dump_words("job", (uint64_t)(uintptr_t)*job, 64);
+               panvk_dump_words("fault", (fault & ~0xffull) - 0x40, 64);
+               panvk_dump_words("fault+", (fault & ~0xffull) + 0xc0, 64);
+               /* Pointers in the job payload, to see what the fault address belongs to. */
+               for (unsigned i = 8; i < 62; i += 2) {
+                  uint64_t ptr = ((uint64_t)w[i] | ((uint64_t)w[i + 1] << 32)) & ~0x3full;
+                  if (ptr >> 32 && ptr >> 48 == 0)
+                     panvk_dump_words("ptr", ptr, 48);
+               }
+            }
             k++;
          }
          b++;
diff --git a/src/panfrost/vulkan/panvk_cmd_desc_state.h b/src/panfrost/vulkan/panvk_cmd_desc_state.h
index 3bde62f..d479bb9 100644
