index 85060fe..8acf7b7 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -95,6 +95,8 @@ struct panvk_device {
       VkImageView view;
       VkBuffer buffer;
       VkDeviceMemory buffer_mem;
+      VkBuffer surf_buffer;
+      VkDeviceMemory surf_mem;
    } null_descs;
 
    struct {
diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index e711743..46cfe47 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -10,6 +10,11 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <dlfcn.h>
+#include <libgen.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 #include <sys/stat.h>
 
 #include "util/build_id.h"
@@ -61,9 +66,46 @@ static const struct debug_control panvk_debug_options[] = {
 
 uint64_t panvk_debug;
 
+/* Apps that load the driver from their own data directory (AdrenoTools-style
+ * loaders in Winlator, ARMSX2, Eden) give no way to set environment variables.
+ * Read KEY=VALUE lines from panvk.env next to the driver instead; variables
+ * already in the environment win. */
+static void
+panvk_load_env_file(void)
+{
+   Dl_info info;
+   if (!dladdr((void *)panvk_load_env_file, &info) || !info.dli_fname)
+      return;
+
+   char path[4096];
+   snprintf(path, sizeof(path), "%s", info.dli_fname);
+   char *dir = dirname(path);
+   char file[4096];
+   snprintf(file, sizeof(file), "%s/panvk.env", dir);
+
+   FILE *f = fopen(file, "r");
+   if (!f)
+      return;
+
+   char line[1024];
+   while (fgets(line, sizeof(line), f)) {
+      line[strcspn(line, "\r\n")] = 0;
+      if (line[0] == '#' || !line[0])
+         continue;
+      char *eq = strchr(line, '=');
+      if (!eq || eq == line)
+         continue;
+      *eq = 0;
+      setenv(line, eq + 1, 0);
+      mesa_logi("panvk: %s=%s (from %s)", line, getenv(line), file);
+   }
+   fclose(f);
+}
+
 static void
 panvk_debug_init_once(void)
 {
+   panvk_load_env_file();
    panvk_debug =
       parse_debug_string(os_get_option("PANVK_DEBUG"), panvk_debug_options);
 }
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index da0748c..0d59815 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -560,6 +560,71 @@ panvk_init_null_descs(struct panvk_device *dev)
    GENX(pan_buffer_texture_emit)(&bview, &texel.buf, &texel.attr);
    memcpy(dev->null_descs.texel, &texel, sizeof(texel));
 
+   /* The view's texture has one surface, but a shader that samples a null
+    * binding as an array or cube still indexes surfaces by layer, face and
+    * level, and the GPU reads whatever follows the single entry as a surface
+    * pointer (DATA_INVALID_FAULT). Point the null texture at a table of
+    * surfaces that all read the zero buffer instead. */
+   const unsigned nr_surfs = 256;
+   const VkBufferCreateInfo sbci = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = nr_surfs * pan_size(SURFACE_WITH_STRIDE),
+      .usage = VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT,
+   };
+   result = t->CreateBuffer(h, &sbci, NULL, &dev->null_descs.surf_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+   t->GetBufferMemoryRequirements(h, dev->null_descs.surf_buffer, &mr);
+
+   const struct panvk_physical_device *pdev =
+      to_panvk_physical_device(dev->vk.physical);
+   int host_type = -1;
+   for (uint32_t i = 0; i < pdev->memory.type_count; i++) {
+      if ((mr.memoryTypeBits & BITFIELD_BIT(i)) &&
+          (pdev->memory.types[i].propertyFlags &
+           VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+         host_type = i;
+         break;
+      }
+   }
+   if (host_type < 0)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   mai.allocationSize = mr.size;
+   mai.memoryTypeIndex = host_type;
+   result = t->AllocateMemory(h, &mai, NULL, &dev->null_descs.surf_mem);
+   if (result != VK_SUCCESS)
+      return result;
+   t->BindBufferMemory(h, dev->null_descs.surf_buffer, dev->null_descs.surf_mem, 0);
+
+   void *surfs;
+   result = t->MapMemory(h, dev->null_descs.surf_mem, 0, VK_WHOLE_SIZE, 0, &surfs);
+   if (result != VK_SUCCESS)
+      return result;
+   struct mali_surface_with_stride_packed *surf = surfs;
+   for (unsigned i = 0; i < nr_surfs; i++) {
+      pan_pack(&surf[i], SURFACE_WITH_STRIDE, cfg) {
+         cfg.pointer = dev->null_descs.zero_addr;
+         cfg.row_stride = 0;
+         cfg.surface_stride = 0;
+      }
+   }
+   const VkMappedMemoryRange range = {
+      .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+      .memory = dev->null_descs.surf_mem,
+      .size = VK_WHOLE_SIZE,
+   };
+   t->FlushMappedMemoryRanges(h, 1, &range);
+   t->UnmapMemory(h, dev->null_descs.surf_mem);
+
+   VK_FROM_HANDLE(panvk_buffer, surf_buf, dev->null_descs.surf_buffer);
+   struct mali_texture_packed *null_tex = (void *)dev->null_descs.tex;
+   pan_unpack(null_tex, TEXTURE, tex_cfg);
+   pan_pack(null_tex, TEXTURE, cfg) {
+      cfg = tex_cfg;
+      cfg.surfaces = panvk_buffer_gpu_ptr(surf_buf, 0);
+   }
+
    dev->null_descs.valid = true;
    return VK_SUCCESS;
 }
@@ -580,6 +645,10 @@ panvk_finish_null_descs(struct panvk_device *dev)
       t->DestroyBuffer(h, dev->null_descs.buffer, NULL);
    if (dev->null_descs.buffer_mem)
       t->FreeMemory(h, dev->null_descs.buffer_mem, NULL);
+   if (dev->null_descs.surf_buffer)
+      t->DestroyBuffer(h, dev->null_descs.surf_buffer, NULL);
+   if (dev->null_descs.surf_mem)
+      t->FreeMemory(h, dev->null_descs.surf_mem, NULL);
    memset(&dev->null_descs, 0, sizeof(dev->null_descs));
 }
 #endif
