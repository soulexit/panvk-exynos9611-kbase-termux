From 45704671cc2b61de040de4ec83abdb59979af497 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Fri, 30 Oct 2026 03:27:16 +0300
Subject: [PATCH 16/16] panvk/jm: layered rendering with geometry shaders

- a draw replays per layer only when a pre-rasterization stage writes
  gl_Layer (or for multiview): otherwise its primitives belong on layer
  0, and drawing them on every layer was wrong and slow;
- the geometry shader emulation moves vertices for other layers off
  screen in each layer's pass, and lower_layer_writes, which reads the
  graphics layer_id sysval, is left to vertex shaders: geometry and tess
  eval shaders run as compute;
- an empty vertex shader in front of a geometry shader or tessellation
  writes a zero position, so its draw is not skipped as having no
  vertex shader (the next stage makes the primitives).

geometry.layered CTS: 100 -> 8 failures.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 32 ++++++++++++++++++----
 src/panfrost/vulkan/panvk_gs.h             |  4 ++-
 src/panfrost/vulkan/panvk_nir_lower_gs.c   | 13 +++++++++
 src/panfrost/vulkan/panvk_shader.h         |  3 ++
 src/panfrost/vulkan/panvk_vX_shader.c      | 21 +++++++++++++-
 5 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index fa39a3a..b98f8e6 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -2095,6 +2095,7 @@ emit_gs_job(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw,
       .xfb_stream_slots = tes_out ? 0 : cmdbuf->state.gfx.gs.xfb_stream_slots,
       .xfb_stream_idx = tes_out ? 0 : cmdbuf->state.gfx.gs.xfb_stream_idx,
       .xfb_invocations = tes_out ? 0 : cmdbuf->state.gfx.gs.xfb_invocations,
+      .layer = draw->info.layer_id,
       /* The tess eval job leaves clip-space positions for the geometry shader job. */
       .in_screen_space =
          !tes_in && !panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader)->gs.vs_clip_space,
@@ -2585,6 +2586,29 @@ panvk_note_path(const char *what)
    simple_mtx_unlock(&lock);
 }
 
+/* The layers a draw runs on. Every view of multiview; otherwise, layered rendering puts each
+ * primitive on the layer its last pre-rasterization stage writes, and on layer 0 when that
+ * stage writes none -- so only a stage writing gl_Layer needs the draw replayed per layer. */
+static uint32_t
+draw_layer_count(const struct panvk_cmd_buffer *cmdbuf)
+{
+   const uint32_t view_mask = cmdbuf->state.gfx.render.view_mask;
+   if (view_mask)
+      return util_bitcount(view_mask);
+
+   const struct panvk_shader *app_gs = cmdbuf->state.gfx.gs.app_shader;
+   const struct panvk_shader *tes = cmdbuf->state.gfx.tess.tes;
+   const struct panvk_shader_variant *vs = panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader);
+   const bool writes_layer =
+      app_gs ? (panvk_shader_only_variant(app_gs)->gs.outputs_written &
+                BITFIELD64_BIT(VARYING_SLOT_LAYER)) != 0
+      : tes  ? (panvk_shader_only_variant(tes)->gs.outputs_written &
+                BITFIELD64_BIT(VARYING_SLOT_LAYER)) != 0
+             : vs->gs.vs_writes_layer;
+   return writes_layer ? cmdbuf->state.gfx.render.layer_count
+                       : MIN2(cmdbuf->state.gfx.render.layer_count, 1);
+}
+
 static void
 panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
 {
@@ -2634,9 +2658,7 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
 
    uint32_t view_mask = cmdbuf->state.gfx.render.view_mask;
    assert(view_mask == 0 || util_bitcount(view_mask) <= batch->fb.layer_count);
-   uint32_t enabled_layer_count = view_mask
-                                     ? util_bitcount(view_mask)
-                                     : cmdbuf->state.gfx.render.layer_count;
+   uint32_t enabled_layer_count = draw_layer_count(cmdbuf);
 
    for (uint32_t i = 0; i < enabled_layer_count; i++) {
       const uint32_t layer = (view_mask != 0) ? u_bit_scan(&view_mask) : i;
@@ -2822,9 +2844,7 @@ panvk_cmd_draw_indirect(struct panvk_cmd_buffer *cmdbuf,
 
    uint32_t view_mask = cmdbuf->state.gfx.render.view_mask;
    assert(view_mask == 0 || util_bitcount(view_mask) <= batch->fb.layer_count);
-   uint32_t enabled_layer_count = view_mask
-                                     ? util_bitcount(view_mask)
-                                     : cmdbuf->state.gfx.render.layer_count;
+   uint32_t enabled_layer_count = draw_layer_count(cmdbuf);
 
    const unsigned ready_job = draw_helper_ready_job(cmdbuf);
    if (!ready_job)
