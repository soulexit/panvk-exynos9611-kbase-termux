 };
 
 /* gl_ViewportIndex, carried from the emulation to the fragment shader. VARYING_SLOT_VIEWPORT is a
diff --git a/src/panfrost/vulkan/panvk_nir_lower_gs.c b/src/panfrost/vulkan/panvk_nir_lower_gs.c
index 011242f..ced51d6 100644
--- a/src/panfrost/vulkan/panvk_nir_lower_gs.c
+++ b/src/panfrost/vulkan/panvk_nir_lower_gs.c
@@ -108,6 +108,9 @@ struct lower_gs_state {
    /* gl_ViewportIndex: the shader's variable, and the per-viewport transform table. */
    nir_variable *viewport_var;
    nir_def *viewports;
+   /* gl_Layer: the shader's variable, and the layer this pass draws. */
+   nir_variable *layer_var;
+   nir_def *layer;
    /* gl_PrimitiveIDIn (per instance) and gl_InvocationID. */
    nir_def *prim_id;
    nir_def *invocation_id;
@@ -660,6 +663,13 @@ lower_emit_vertex(nir_builder *b, nir_intrinsic_instr *intr, struct lower_gs_sta
             }
             if (!opts->hardpos)
                val = nir_bcsel(b, nir_ine_imm(b, st->out_clip_space, 0), clip, val);
+            /* Layered rendering draws once per layer: a vertex for another layer goes far off
+             * screen, which takes its primitive out of this layer's tiles. */
+            if (st->layer_var) {
+               nir_def *off = nir_imm_vec4(b, -65536.0, -65536.0, 0.5, 1.0);
+               val = nir_bcsel(b, nir_ieq(b, nir_load_var(b, st->layer_var), st->layer), val,
+                               off);
+            }
             if (opts->hardpos) {
                /* Screen space, 64x64: (4,60) (32,60) (60,4). */
                nir_def *fc = nir_u2f32(b, counter);
@@ -985,6 +995,9 @@ panvk_nir_lower_gs(struct nir_shader *nir, const struct panvk_gs_lower_options *
       nir_find_variable_with_location(nir, nir_var_shader_out, VARYING_SLOT_VIEWPORT);
    if (st.viewport_var)
       st.viewports = load_param_u64(&b, opts, offsetof(struct panvk_gs_push, viewports));
+   st.layer_var = nir_find_variable_with_location(nir, nir_var_shader_out, VARYING_SLOT_LAYER);
+   if (st.layer_var)
+      st.layer = load_param_u32(&b, opts, offsetof(struct panvk_gs_push, layer));
    st.in_general_stride =
       load_param_u32(&b, opts, offsetof(struct panvk_gs_push, in_general_stride));
    st.out_general_stride =
diff --git a/src/panfrost/vulkan/panvk_shader.h b/src/panfrost/vulkan/panvk_shader.h
index 9e28f90..8b18248 100644
--- a/src/panfrost/vulkan/panvk_shader.h
+++ b/src/panfrost/vulkan/panvk_shader.h
@@ -454,6 +454,9 @@ struct panvk_shader_variant {
       /* Vertex shader variants: compiled to feed the emulation, so gl_Position is clip space
        * (pan_compile_inputs::vs_keep_clip_space) and must be stored unsnapped. */
       bool vs_clip_space;
+      /* Vertex shader variants: writes gl_Layer (filtered per layer, see lower_layer_writes).
+       * Geometry and tess eval shaders say so in outputs_written. */
+      bool vs_writes_layer;
       /* Vertex shader variants: how many clip and cull distances it writes, in that order in
        * VARYING_SLOT_CLIP_DIST0/1 (see panvk_nir_lower_cull_vs). The fragment shader linked
        * against it tests exactly these. */
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index 0f0f928..8f74e76 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -274,7 +274,9 @@ lower_gl_pos_layer_writes(nir_builder *b, nir_instr *instr, void *data)
 static bool
 lower_layer_writes(nir_shader *nir)
 {
-   if (nir->info.stage == MESA_SHADER_FRAGMENT)
+   /* Geometry and tess eval shaders run as compute through the emulation, which drops the
+    * primitives of other layers itself (panvk_nir_lower_gs.c). */
+   if (nir->info.stage != MESA_SHADER_VERTEX)
       return false;
 
    nir_variable *temp_layer_var = NULL;
@@ -1931,10 +1933,27 @@ panvk_compile_shader(struct panvk_device *dev,
          NIR_PASS(_, info->nir, nir_lower_var_copies);
          NIR_PASS(_, info->nir, panvk_nir_lower_cull_vs, clip_count);
       }
+
+      /* An empty shader compiles to nothing, and a draw without a vertex shader binary is
+       * skipped -- but in front of a geometry shader (or tessellation) the draw still has to run,
+       * since that stage makes the primitives. A vertex shader that writes no position writes a
+       * zero one (what the next stage reads of it is undefined), which keeps it non-empty. */
+      if (inputs.vs_keep_clip_space && !info->nir->info.io_lowered &&
+          !nir_find_variable_with_location(info->nir, nir_var_shader_out, VARYING_SLOT_POS)) {
+         nir_variable *pos = nir_variable_create(info->nir, nir_var_shader_out,
+                                                 glsl_vec4_type(), "gl_Position");
+         pos->data.location = VARYING_SLOT_POS;
+         nir_function_impl *impl = nir_shader_get_entrypoint(info->nir);
+         nir_builder pb = nir_builder_at(nir_after_impl(impl));
+         nir_store_var(&pb, pos, nir_imm_vec4(&pb, 0.0, 0.0, 0.0, 1.0), 0xf);
+         info->nir->info.outputs_written |= VARYING_BIT_POS;
+      }
 #endif
       for (enum panvk_vs_variant v = 0; v <= last_variant; v++) {
          struct panvk_shader_variant *variant = &shader->variants[v];
          variant->gs.vs_clip_space = inputs.vs_keep_clip_space;
+         variant->gs.vs_writes_layer =
+            nir_find_variable_with_location(info->nir, nir_var_shader_out, VARYING_SLOT_LAYER);
 #if PAN_ARCH < 9
          variant->gs.vs_clip_count = clip_count;
          variant->gs.vs_cull_count = cull_count;
