From 24bb8b14ebdb1e76d8610218413a6ecb5c39aec1 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Fri, 30 Oct 2026 00:48:28 +0300
Subject: [PATCH 07/16] panvk/jm: pass the VS image attribute buffer offset as
 an index

meta_get_copy_desc_job adds attrib_buf_idx_offset to an attribute buffer
index, but the vertex shader path passed a byte offset, so every image
in a vertex shader pointed past the attribute buffer table. Fixes 64
dEQP-VK.synchronization2.op.single_queue failures.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 324ee95..cf533e4 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -1513,7 +1513,7 @@ panvk_draw_prepare_vs_copy_desc_job(struct panvk_cmd_buffer *cmdbuf,
 
    VkResult result = panvk_per_arch(meta_get_copy_desc_job)(
       cmdbuf, vs_desc_info, &cmdbuf->state.gfx.desc_state, vs_desc_state,
-      num_vbs * pan_size(ATTRIBUTE_BUFFER) * 2, &ptr);
+      num_vbs * 2, &ptr);
    if (result != VK_SUCCESS)
       return result;
 
