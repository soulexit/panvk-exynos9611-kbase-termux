From 0938f5fb3141a4b4bd1bb44cdf185c6ca865dd6c Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Fri, 30 Oct 2026 01:15:26 +0300
Subject: [PATCH 09/16] panvk/bifrost: make null descriptors and OOB texel
 loads read zero

On Bifrost the null image, texel buffer and texture descriptors returned
the wrong values for robustness2:
- size queries add 1 to minus(1) fields, so a null image or texture
  reported a size of 1. Null storage images are detected by their 0-byte
  attribute buffer, and the v6 null texture is marked by a 0000 format
  swizzle, which only PIPE_FORMAT_NONE has.
- a load the attribute buffer bounds reject returns (0,0,0,1). Null image
  and texel buffer loads now return (0,0,0,0), and so do out-of-bounds
  texel buffer loads of formats with alpha under robustBufferAccess2.

EXT_robustness2 CTS sample: 175 -> 8 failures.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_vX_device.c         |  15 +-
 .../vulkan/panvk_vX_nir_lower_descriptors.c   | 133 +++++++++++++++++-
 2 files changed, 141 insertions(+), 7 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 0d59815..d4a1e28 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -464,7 +464,8 @@ cleanup_va_heaps(struct panvk_device *device)
 /* See panvk_device::null_descs. Built through the device's own entry points, so the texture and
  * attribute descriptors come out exactly as for an application's image and buffer. kbase hands
  * out zeroed pages, and nothing ever writes these: a null storage image or texel buffer has a
- * 0-byte range, so its stores are dropped. */
+ * 0-byte range, so its stores are dropped. Its loads return the out-of-bounds (0,0,0,1), which
+ * the shader turns into zeros (texel_fixup_prepare). */
 static VkResult
 panvk_init_null_descs(struct panvk_device *dev)
 {
@@ -516,6 +517,18 @@ panvk_init_null_descs(struct panvk_device *dev)
    static_assert(sizeof(view->descs.tex[0]) == sizeof(dev->null_descs.tex), "texture size");
    static_assert(sizeof(view->descs.img_attrib_buf) == sizeof(dev->null_descs.img), "image size");
    memcpy(dev->null_descs.tex, &view->descs.tex[0], sizeof(dev->null_descs.tex));
+#if PAN_ARCH == 6
+   /* Mark the null texture with a 0000 format swizzle (only PIPE_FORMAT_NONE has it) so size
+    * queries can return 0 for it: see null_desc_zero. The view swizzle already reads 0. */
+   {
+      struct mali_texture_packed *ntex = (struct mali_texture_packed *)dev->null_descs.tex;
+      pan_unpack(ntex, TEXTURE, tcfg);
+      pan_pack(ntex, TEXTURE, cfg) {
+         cfg = tcfg;
+         cfg.format = (tcfg.format & ~0xfffu) | PAN_V6_SWIZZLE(0, 0, 0, 0);
+      }
+   }
+#endif
 
    struct mali_attribute_buffer_packed img[2];
    memcpy(img, view->descs.img_attrib_buf, sizeof(img));
diff --git a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
index 19750a4..2eca629 100644
--- a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
+++ b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
@@ -22,6 +22,7 @@
 
 #include "util/bitset.h"
 #include "pan_nir.h"
+#include "pan_format.h"
 
 #if PAN_ARCH >= 9
 #define VALHALL_RESOURCE_TABLE_IDX 62
@@ -58,6 +59,7 @@ struct lower_desc_ctx {
    struct hash_table_u64 *ht;
    bool add_bounds_checks;
    bool null_descriptor_support;
+   bool robust_texel_buffers2;
    nir_address_format ubo_addr_format;
    nir_address_format ssbo_addr_format;
 };
@@ -572,6 +574,33 @@ load_resource_deref_desc(nir_builder *b, nir_deref_instr *deref,
 }
 
 #if PAN_ARCH < 9
+/* Bifrost size queries add 1 to minus(1) fields, so a null descriptor would report a size of
+ * one. The v6 null texture is marked by a 0000 format swizzle, which no real format uses (see
+ * panvk_device_init_null_descs), and a null storage image by a zero attribute buffer size. */
+static nir_def *
+null_desc_zero(nir_builder *b, nir_deref_instr *deref, bool img, nir_def *res,
+               const struct lower_desc_ctx *ctx)
+{
+   if (!ctx->null_descriptor_support)
+      return res;
+
+   nir_def *is_null;
+   if (img) {
+      nir_def *size = load_resource_deref_desc(
+         b, deref, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 12, 1, 32, ctx);
+      is_null = nir_ieq_imm(b, size, 0);
+   } else {
+      /* On v7 these bits are a component order, and the null texture is not marked. */
+      if (PAN_ARCH != 6)
+         return res;
+      nir_def *w0 = load_resource_deref_desc(
+         b, deref, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 0, 1, 32, ctx);
+      is_null = nir_ieq_imm(b, nir_iand_imm(b, nir_ushr_imm(b, w0, 10), 0xfff),
+                            PAN_V6_SWIZZLE(0, 0, 0, 0));
+   }
+   return nir_bcsel(b, is_null, nir_imm_zero(b, res->num_components, res->bit_size), res);
+}
+
 static nir_def *
 load_tex_size(nir_builder *b, nir_deref_instr *deref, enum glsl_sampler_dim dim,
               bool is_array, const struct lower_desc_ctx *ctx)
@@ -604,8 +633,7 @@ load_tex_size(nir_builder *b, nir_deref_instr *deref, enum glsl_sampler_dim dim,
       loaded_size = nir_iadd_imm(b, nir_u2u32(b, tex_sz), 1);
    }
 
-   /* TODO/Bifrost: Null descriptors */
-   assert(PAN_ARCH < 9 && !ctx->null_descriptor_support);
+   /* Null descriptors: see null_desc_zero. */
 
    return loaded_size;
 }
@@ -674,8 +702,7 @@ load_tex_levels(nir_builder *b, nir_deref_instr *deref,
    nir_def *lod_count = nir_iand_imm(b, nir_ushr_imm(b, tex_word2, 16), 0x1f);
    nir_def *loaded_levels = nir_iadd_imm(b, lod_count, 1);
 
-   /* TODO/Bifrost: Null descriptors */
-   assert(PAN_ARCH < 9 && !ctx->null_descriptor_support);
+   /* Null descriptors: see null_desc_zero. */
 
    return loaded_levels;
 }
@@ -692,8 +719,7 @@ load_tex_samples(nir_builder *b, nir_deref_instr *deref,
    nir_def *sample_count = nir_iand_imm(b, nir_ushr_imm(b, tex_word3, 13), 0x7);
    nir_def *loaded_samples = nir_ishl(b, nir_imm_int(b, 1), sample_count);
 
-   /* TODO/Bifrost: Null descriptors */
-   assert(PAN_ARCH < 9 && !ctx->null_descriptor_support);
+   /* Null descriptors: see null_desc_zero. */
 
    return loaded_samples;
 }
@@ -819,6 +845,66 @@ lower_tex_immutable(nir_builder *b, nir_tex_instr *tex,
    }
 }
 
+#if PAN_ARCH < 9
+/* An access the attribute buffer bounds reject (a null image or texel buffer has a 0-byte
+ * one) loads (0,0,0,1). A null descriptor has to load (0,0,0,0), and so does an out-of-bounds
+ * texel of a texel buffer whose format has alpha under robustBufferAccess2. Image and texel
+ * buffer descriptors both start with the attribute buffer, whose size word is at byte 12. */
+struct texel_fixup {
+   nir_def *is_null, *zero_w;
+};
+
+static struct texel_fixup
+texel_fixup_prepare(nir_builder *b, nir_deref_instr *deref, bool is_buf,
+                    unsigned num_components, nir_def *coord,
+                    const struct lower_desc_ctx *ctx)
+{
+   struct texel_fixup fix = {0};
+   const bool fix_oob = is_buf && ctx->robust_texel_buffers2 && PAN_ARCH == 6 &&
+                        num_components == 4;
+   if (!ctx->null_descriptor_support && !fix_oob)
+      return fix;
+
+   nir_def *stride_size = load_resource_deref_desc(
+      b, deref, VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, 8, 2, 32, ctx);
+   nir_def *size = nir_channel(b, stride_size, 1);
+   if (ctx->null_descriptor_support)
+      fix.is_null = nir_ieq_imm(b, size, 0);
+   if (fix_oob) {
+      /* The format's swizzle sits in bits 10..21 of the attribute word at byte 16; an A
+       * channel other than 1 means the format has alpha. */
+      nir_def *attr = load_resource_deref_desc(
+         b, deref, VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, 16, 1, 32, ctx);
+      nir_def *has_alpha = nir_ine_imm(
+         b, nir_iand_imm(b, nir_ushr_imm(b, attr, 10 + 9), 0x7), MALI_CHANNEL_1);
+      nir_def *n = nir_udiv(b, size, nir_umax(b, nir_channel(b, stride_size, 0),
+                                              nir_imm_int(b, 1)));
+      nir_def *oob = nir_uge(b, nir_u2u32(b, nir_channel(b, coord, 0)), n);
+      fix.zero_w = nir_iand(b, oob, has_alpha);
+   }
+   return fix;
+}
+
+static void
+texel_fixup_apply(nir_builder *b, nir_instr *instr, nir_def *res,
+                  const struct texel_fixup *fix)
+{
+   if (!fix->is_null && !fix->zero_w)
+      return;
+
+   b->cursor = nir_after_instr(instr);
+   nir_def *zero = nir_imm_zero(b, res->num_components, res->bit_size);
+   nir_def *fixed = res;
+   if (fix->zero_w)
+      fixed = nir_vector_insert_imm(
+         b, fixed, nir_bcsel(b, fix->zero_w, nir_channel(b, zero, 0), nir_channel(b, res, 3)),
+         3);
+   if (fix->is_null)
+      fixed = nir_bcsel(b, fix->is_null, zero, fixed);
+   nir_def_rewrite_uses_after(res, fixed);
+}
+#endif
+
 static bool
 lower_tex(nir_builder *b, nir_tex_instr *tex, const struct lower_desc_ctx *ctx)
 {
@@ -865,12 +951,25 @@ lower_tex(nir_builder *b, nir_tex_instr *tex, const struct lower_desc_ctx *ctx)
       default:
          UNREACHABLE("Unsupported texture query op");
       }
+      if (dim != GLSL_SAMPLER_DIM_BUF)
+         res = null_desc_zero(b, deref, false, res, ctx);
 
       nir_def_replace(&tex->def, res);
       return true;
    }
 #endif
 
+#if PAN_ARCH < 9
+   struct texel_fixup fix = {0};
+   if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF && tex->op == nir_texop_txf) {
+      int tex_src_idx = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+      int coord_idx = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+      if (tex_src_idx >= 0 && coord_idx >= 0)
+         fix = texel_fixup_prepare(b, nir_src_as_deref(tex->src[tex_src_idx].src), true,
+                                   tex->def.num_components, tex->src[coord_idx].src.ssa, ctx);
+   }
+#endif
+
    uint32_t plane = 0;
    int sampler_src_idx =
       nir_tex_instr_src_index(tex, nir_tex_src_sampler_deref);
@@ -955,6 +1054,9 @@ lower_tex(nir_builder *b, nir_tex_instr *tex, const struct lower_desc_ctx *ctx)
       UNREACHABLE("nir_op_tex must have a texture deref");
    }
 
+#if PAN_ARCH < 9
+   texel_fixup_apply(b, &tex->instr, &tex->def, &fix);
+#endif
    return progress;
 }
 
@@ -1009,12 +1111,26 @@ lower_img_intrinsic(nir_builder *b, nir_intrinsic_instr *intr,
       default:
          UNREACHABLE("Unsupported image query op");
       }
+      if (dim != GLSL_SAMPLER_DIM_BUF)
+         res = null_desc_zero(b, deref, true, res, ctx);
 
       nir_def_replace(&intr->def, res);
       return true;
    }
 #endif
 
+#if PAN_ARCH < 9
+   const bool is_buf = nir_intrinsic_image_dim(intr) == GLSL_SAMPLER_DIM_BUF;
+   if (intr->intrinsic == nir_intrinsic_image_deref_load) {
+      struct texel_fixup fix = texel_fixup_prepare(
+         b, deref, is_buf, intr->def.num_components, intr->src[1].ssa, ctx);
+      nir_rewrite_image_intrinsic(intr, get_img_index(b, deref, ctx),
+                                  nir_image_intrinsic_type_default);
+      texel_fixup_apply(b, &intr->instr, &intr->def, &fix);
+      return true;
+   }
+#endif
+
    nir_rewrite_image_intrinsic(intr, get_img_index(b, deref, ctx),
                                nir_image_intrinsic_type_default);
 
@@ -1448,6 +1564,11 @@ panvk_per_arch(nir_lower_descriptors)(
             VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED_EXT ||
          rs->images != VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_DISABLED_EXT,
       .null_descriptor_support = dev->vk.enabled_features.nullDescriptor,
+      .robust_texel_buffers2 =
+         rs->storage_buffers ==
+            VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_2_EXT ||
+         rs->uniform_buffers ==
+            VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_2_EXT,
    };
    bool progress = false;
 
