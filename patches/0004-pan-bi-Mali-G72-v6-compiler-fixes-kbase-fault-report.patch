    for (unsigned i = 0; i < nr_atoms; i++) {
       assert(atoms[i].atom_number != 0);
       jd[i].jc = atoms[i].jc;
+      q->jc[real[i]] = atoms[i].jc;
       jd[i].core_req = atoms[i].core_req;
       jd[i].atom_number = real[i];
       /* udata is opaque to the kernel and comes back verbatim in the completion event: the tag
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 917a796..5feb135 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -366,6 +366,58 @@ panvk_dump_fault_draws(struct panvk_batch *batch, unsigned b)
          draws[1] = pan_section_ptr(job, INDEXED_VERTEX_JOB, FRAGMENT_DRAW);
       }
       fprintf(txt, "job %u type %u status 0x%x\n", k, type, w[0]);
+      if (type == MALI_JOB_TYPE_FRAGMENT) {
+         pan_section_unpack(job, FRAGMENT_JOB, PAYLOAD, frag);
+         uint64_t fbd = frag.framebuffer & ~0x3full;
+         fprintf(txt, " fbd 0x%" PRIx64 " bounds %u,%u-%u,%u\n", fbd, frag.bound_min_x,
+                 frag.bound_min_y, frag.bound_max_x, frag.bound_max_y);
+         if (fbd && kbase_kmod_va_check(fbd, 128 + 64 * 9) != 0) {
+            const uint32_t *fw = (const uint32_t *)(uintptr_t)fbd;
+            fprintf(txt, "  fbd words:");
+            for (unsigned i = 0; i < 32 + 16 + 16 * 2; i++)
+               fprintf(txt, " %08x", fw[i]);
+            fputc('\n', txt);
+            pan_section_unpack((const void *)(uintptr_t)fbd, FRAMEBUFFER, PARAMETERS, fbp);
+            fprintf(txt, "  pre0 %u pre1 %u post %u dcds 0x%" PRIx64 " rts %u zs_ext %u\n",
+                    fbp.pre_frame_0, fbp.pre_frame_1, fbp.post_frame, fbp.frame_shader_dcds,
+                    fbp.render_target_count, fbp.has_zs_crc_extension);
+            const enum mali_pre_post_frame_shader_mode modes[3] = {
+               fbp.pre_frame_0, fbp.pre_frame_1, fbp.post_frame};
+            for (unsigned fi = 0; fi < 3; fi++) {
+               if (modes[fi] == MALI_PRE_POST_FRAME_SHADER_MODE_NEVER || !fbp.frame_shader_dcds)
+                  continue;
+               uint64_t dcd = fbp.frame_shader_dcds + fi * pan_size(DRAW);
+               pan_unpack((const struct mali_draw_packed *)(uintptr_t)dcd, DRAW, fd);
+               fprintf(txt, "  frame shader %u: textures 0x%" PRIx64 " state 0x%" PRIx64 "\n", fi,
+                       fd.textures, fd.state);
+               if (fd.state && kbase_kmod_va_check(fd.state, 64) != 0) {
+                  pan_unpack((const struct mali_renderer_state_packed *)(uintptr_t)fd.state,
+                             RENDERER_STATE, frs);
+                  for (unsigned ti = 0; ti < frs.shader.texture_count && ti < 8; ti++) {
+                     uint64_t tva = fd.textures + ti * pan_size(TEXTURE);
+                     if (kbase_kmod_va_check(tva, pan_size(TEXTURE)) == 0)
+                        continue;
+                     const uint32_t *tw = (const uint32_t *)(uintptr_t)tva;
+                     pan_unpack((const struct mali_texture_packed *)tw, TEXTURE, tex);
+                     fprintf(txt, "   tex %u: dim %u %ux%u levels %u array %u depth %u surfaces 0x%"
+                             PRIx64 " words %08x %08x %08x %08x %08x %08x %08x %08x\n",
+                             ti, tex.dimension, tex.width, tex.height, tex.levels, tex.array_size,
+                             tex.depth, tex.surfaces, tw[0], tw[1], tw[2], tw[3], tw[4], tw[5],
+                             tw[6], tw[7]);
+                     for (unsigned si = 0; si < 4 && tex.surfaces; si++) {
+                        uint64_t sva = tex.surfaces + si * pan_size(SURFACE_WITH_STRIDE);
+                        if (kbase_kmod_va_check(sva, 16) == 0)
+                           break;
+                        pan_unpack((const struct mali_surface_with_stride_packed *)(uintptr_t)sva,
+                                   SURFACE_WITH_STRIDE, surf);
+                        fprintf(txt, "    surf %u: 0x%" PRIx64 " row %" PRId64 " surface %" PRId64 "\n", si,
+                                surf.pointer, surf.row_stride, surf.surface_stride);
+                     }
+                  }
+               }
+            }
+         }
+      }
       for (unsigned di = 0; di < 2 && draws[di]; di++) {
          const uint32_t *dw = draws[di];
          fprintf(txt, " draw%u:", di);
