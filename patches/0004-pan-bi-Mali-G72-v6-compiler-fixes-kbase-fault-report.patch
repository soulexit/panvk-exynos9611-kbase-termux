+
+/* The first few failed atoms: walk the job chain, report the job that did not finish, and when
+ * its fault address lies in a known shader (PANVK_VALIDATE registers them), save that shader. */
+static void
+kbase_report_bad_chain(unsigned an, uint64_t jc, unsigned code)
+{
+   static unsigned reports;
+   if (reports >= 6 || !jc)
+      return;
+   reports++;
+
+   uint64_t job = jc;
+   for (unsigned n = 0; job && n < 1024; n++) {
+      const uint32_t *w = (const uint32_t *)(uintptr_t)job;
+      const uint32_t status = w[0];
+      uint64_t fault = (uint64_t)w[2] | ((uint64_t)w[3] << 32);
+      const unsigned type = (w[4] >> 1) & 0x7f;
+      if (status > 1) {
+         size_t size = 0;
+         /* Instruction faults report the clause address >> 4 with flags above bit 40. */
+         if (status >= 0x50 && status <= 0x57)
+            fault = (fault & 0xffffffffffull) << 4;
+         const void *bin = fault ? kbase_kmod_shader_lookup(fault, &size) : NULL;
+         /* Compute and vertex jobs: the draw descriptor at +64 holds the renderer state at
+          * word 14, whose first word is the shader. */
+         uint64_t shader_va = 0;
+         if (type == 4 || type == 5) {
+            const uint64_t rsd = *(const uint64_t *)(uintptr_t)(job + 64 + 14 * 4);
+            if (rsd)
+               shader_va = *(const uint64_t *)(uintptr_t)rsd & ~0xfull;
+            mesa_loge("kbase:   job shader 0x%" PRIx64 " (rsd 0x%" PRIx64 ")", shader_va, rsd);
+            if (!bin && shader_va) {
+               bin = kbase_kmod_shader_lookup(shader_va, &size);
+               if (bin)
+                  fault = shader_va;
+            }
+         }
+         mesa_loge("kbase: atom %u (code %u) job 0x%" PRIx64 " type %u status 0x%x fault 0x%" PRIx64
+                   "%s", an, code, job, type, status, fault, bin ? " (in a known shader)" : "");
+         if (bin) {
+            /* lookup returns the shader from the fault address on: find its start. */
+            uint64_t start = fault;
+            size_t s2 = 0;
+            while (start >= 16 && kbase_kmod_shader_lookup(start - 16, &s2))
+               start -= 16;
+            const void *sh = kbase_kmod_shader_lookup(start, &s2);
+            Dl_info info;
+            if (sh && dladdr((void *)kbase_report_bad_chain, &info) && info.dli_fname) {
+               char path[4096];
+               const char *slash = strrchr(info.dli_fname, '/');
+               snprintf(path, sizeof(path), "%.*s/badshader-%d-%u.bin",
+                        slash ? (int)(slash - info.dli_fname) : 1,
+                        slash ? info.dli_fname : ".", getpid(), reports);
+               FILE *f = fopen(path, "wb");
+               if (f) {
+                  fwrite(sh, 1, s2, f);
+                  fclose(f);
+                  mesa_loge("kbase:   shader 0x%" PRIx64 " (%zu bytes, fault at +0x%" PRIx64
+                            ") saved to %s", start, s2, fault - start, path);
+               }
+            }
+         }
+         return;
+      }
+      job = (uint64_t)w[6] | ((uint64_t)w[7] << 32);
+   }
+   mesa_loge("kbase: atom %u (code %u): no job in its chain reports a fault", an, code);
+}
+
 static void *
 kbase_event_thread(void *arg)
 {
@@ -2015,6 +2076,7 @@ kbase_event_thread(void *arg)
             } else {
                mesa_loge("kbase: atom %u finished with event code %u, not DONE", an,
                          ev[i].event_code);
+               kbase_report_bad_chain(an, q->jc[an], ev[i].event_code);
                sub->ok = false;
             }
          }
