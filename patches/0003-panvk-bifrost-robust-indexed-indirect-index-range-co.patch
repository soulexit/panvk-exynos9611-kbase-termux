+#if PAN_ARCH <= 7
+/* On a failed submission, dump the draws of the batch that stopped (its first job that never ran
+ * follows jobs that did): descriptors as text, shaders as raw binaries, next to the driver. */
+static void
+panvk_dump_fault_draws(struct panvk_batch *batch, unsigned b)
+{
+   static unsigned dumps;
+   if (dumps >= 3)
+      return;
+   dumps++;
+
+   Dl_info info;
+   if (!dladdr((void *)panvk_dump_fault_draws, &info) || !info.dli_fname)
+      return;
+   char dir[4096], path[4200];
+   snprintf(dir, sizeof(dir), "%s", info.dli_fname);
+   char *slash = strrchr(dir, '/');
+   if (slash)
+      *slash = 0;
+   snprintf(path, sizeof(path), "%s/draw-%d-%u.txt", dir, getpid(), dumps);
+   FILE *txt = fopen(path, "w");
+   snprintf(path, sizeof(path), "%s/draw-%d-%u.bin", dir, getpid(), dumps);
+   FILE *bin = fopen(path, "wb");
+   if (!txt || !bin) {
+      if (txt)
+         fclose(txt);
+      if (bin)
+         fclose(bin);
+      return;
+   }
+   fprintf(txt, "batch %u\n", b);
+
+   unsigned k = 0;
+   util_dynarray_foreach(&batch->jobs, void *, jobp) {
+      const uint8_t *job = *jobp;
+      const uint32_t *w = (const uint32_t *)job;
+      unsigned type = (w[4] >> 1) & 0x7f;
+      const void *draws[2] = {NULL, NULL};
+      if (type == MALI_JOB_TYPE_TILER)
+         draws[0] = pan_section_ptr(job, TILER_JOB, DRAW);
+      else if (type == MALI_JOB_TYPE_VERTEX || type == MALI_JOB_TYPE_COMPUTE)
+         draws[0] = pan_section_ptr(job, COMPUTE_JOB, DRAW);
+      else if (type == MALI_JOB_TYPE_INDEXED_VERTEX) {
+         draws[0] = pan_section_ptr(job, INDEXED_VERTEX_JOB, VERTEX_DRAW);
+         draws[1] = pan_section_ptr(job, INDEXED_VERTEX_JOB, FRAGMENT_DRAW);
+      }
+      fprintf(txt, "job %u type %u status 0x%x\n", k, type, w[0]);
+      for (unsigned di = 0; di < 2 && draws[di]; di++) {
+         const uint32_t *dw = draws[di];
+         fprintf(txt, " draw%u:", di);
+         for (unsigned i = 0; i < 32; i++)
+            fprintf(txt, " %08x", dw[i]);
+         fputc('\n', txt);
+         pan_unpack((const struct mali_draw_packed *)draws[di], DRAW, d);
