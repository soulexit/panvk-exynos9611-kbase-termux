+/* PANVK_VALIDATE: say once which emulated draw paths an app reaches. */
+static void
+panvk_note_path(const char *what)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("PANVK_VALIDATE") != NULL;
+   if (!enabled)
+      return;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static const char *seen[16];
+   simple_mtx_lock(&lock);
+   for (unsigned i = 0; i < ARRAY_SIZE(seen); i++) {
+      if (seen[i] == what)
+         break;
+      if (!seen[i]) {
+         seen[i] = what;
+         mesa_logi("panvk path: %s", what);
+         break;
+      }
+   }
+   simple_mtx_unlock(&lock);
