+/* PANVK_VALIDATE: shader binaries by GPU address, for fault dumps (shader code is not
+ * CPU-readable at its GPU address). */
+static struct {
+   pthread_mutex_t lock;
+   struct { uint64_t va; const void *bin; size_t size; } *e;
+   unsigned n, max;
+} kbase_shaders = {PTHREAD_MUTEX_INITIALIZER, NULL, 0, 0};
+
+void
+kbase_kmod_shader_register(uint64_t va, const void *bin, size_t size)
+{
+   if (!kbase_live_enabled() || !va)
+      return;
+   pthread_mutex_lock(&kbase_shaders.lock);
+   if (kbase_shaders.n == kbase_shaders.max) {
+      unsigned max = MAX2(256, kbase_shaders.max * 2);
+      void *e = realloc(kbase_shaders.e, max * sizeof(*kbase_shaders.e));
+      if (e) {
+         kbase_shaders.e = e;
+         kbase_shaders.max = max;
+      }
+   }
+   if (kbase_shaders.n < kbase_shaders.max) {
+      void *copy = malloc(size);
+      if (copy) {
+         memcpy(copy, bin, size);
+         kbase_shaders.e[kbase_shaders.n].va = va;
+         kbase_shaders.e[kbase_shaders.n].bin = copy;
+         kbase_shaders.e[kbase_shaders.n].size = size;
+         kbase_shaders.n++;
+      }
+   }
+   pthread_mutex_unlock(&kbase_shaders.lock);
+}
+
+const void *
+kbase_kmod_shader_lookup(uint64_t va, size_t *size)
+{
+   const void *bin = NULL;
+   pthread_mutex_lock(&kbase_shaders.lock);
+   for (unsigned i = kbase_shaders.n; i-- > 0;) {
+      if (va >= kbase_shaders.e[i].va && va < kbase_shaders.e[i].va + kbase_shaders.e[i].size) {
+         bin = (const uint8_t *)kbase_shaders.e[i].bin + (va - kbase_shaders.e[i].va);
+         *size = kbase_shaders.e[i].size - (va - kbase_shaders.e[i].va);
+         break;
+      }
+   }
+   if (!bin) {
+      uint64_t best = 0;
+      for (unsigned i = 0; i < kbase_shaders.n; i++) {
+         if (kbase_shaders.e[i].va <= va && kbase_shaders.e[i].va > best)
+            best = kbase_shaders.e[i].va;
+      }
+      mesa_loge("kbase: shader 0x%" PRIx64 " not among %u registered (closest below 0x%" PRIx64 ")",
+                va, kbase_shaders.n, best);
+   }
+   pthread_mutex_unlock(&kbase_shaders.lock);
+   return bin;
+}
