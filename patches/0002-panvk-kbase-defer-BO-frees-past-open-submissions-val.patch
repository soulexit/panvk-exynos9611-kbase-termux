                     p_atomic_inc_return(&kbase_dev->next_handle));
+   kbase_live_add(bo->gpu_va, pages * 4096);
    return &bo->base;
 }
 
 static void
-kbase_kmod_bo_free(struct pan_kmod_bo *bo)
+kbase_kmod_bo_free_now(struct pan_kmod_bo *bo)
 {
    struct kbase_kmod_bo *kbase_bo = container_of(bo, struct kbase_kmod_bo, base);
 
+   kbase_record_free(kbase_bo->gpu_va, bo->size, kbase_bo->alloc_pc);
+   kbase_live_remove(kbase_bo->gpu_va);
+
    if (kbase_bo->exec) {
       struct kbase_ioctl_mem_free req = {.gpu_addr = kbase_bo->gpu_va};
       if (pan_kmod_ioctl(bo->dev->fd, KBASE_IOCTL_MEM_FREE, &req))
@@ -712,6 +1011,78 @@ kbase_kmod_bo_free(struct pan_kmod_bo *bo)
    pan_kmod_dev_free(bo->dev, kbase_bo);
 }
 
+/* kbase does not hold a reference on the memory a job uses, unlike the DRM
+ * drivers, which keep every BO of a job alive until the job is done. A BO
+ * freed while a submission that may use it is still running is unmapped
+ * under the GPU, which then faults (TRANSLATION_FAULT, JOB_READ_FAULT) and
+ * takes every dependent atom with it. Keep such BOs until every submission
+ * that was open when they were freed has completed. */
+static void
+kbase_kmod_bo_free(struct pan_kmod_bo *bo)
+{
+   struct kbase_kmod_dev *kdev = container_of(bo->dev, struct kbase_kmod_dev, base);
+   struct kbase_queue *q = &kdev->queue;
+
+   if (!kdev->csf) {
+      pthread_mutex_lock(&q->lock);
+      if (q->nr_open_seq) {
+         if (q->nr_deferred == q->max_deferred) {
+            unsigned max = MAX2(64, q->max_deferred * 2);
+            void *d = realloc(q->deferred, max * sizeof(*q->deferred));
+            if (d) {
+               q->deferred = d;
+               q->max_deferred = max;
+            }
+         }
+         if (q->nr_deferred < q->max_deferred) {
+            q->deferred[q->nr_deferred++] =
+               (struct kbase_deferred_free){.bo = bo, .seq = q->next_seq - 1};
+            pthread_mutex_unlock(&q->lock);
+            return;
+         }
+      }
+      pthread_mutex_unlock(&q->lock);
+   }
+
+   kbase_kmod_bo_free_now(bo);
+}
+
+/* Called with q->lock held: moves the BOs no open submission can still use
+ * to out[], returns how many. */
+static unsigned
+kbase_take_retired(struct kbase_queue *q, struct pan_kmod_bo **out, unsigned max)
+{
+   uint64_t oldest_open = UINT64_MAX;
+   for (unsigned k = 0; k < q->nr_open_seq; k++)
+      oldest_open = MIN2(oldest_open, q->open_seq[k]);
+
+   unsigned n = 0;
+   for (unsigned i = 0; i < q->nr_deferred && n < max;) {
+      if (q->deferred[i].seq < oldest_open) {
+         out[n++] = q->deferred[i].bo;
+         q->deferred[i] = q->deferred[--q->nr_deferred];
+      } else {
+         i++;
+      }
+   }
+   return n;
+}
+
+static void
+kbase_release_retired(struct kbase_queue *q)
+{
+   struct pan_kmod_bo *bos[64];
+   for (;;) {
+      pthread_mutex_lock(&q->lock);
+      unsigned n = kbase_take_retired(q, bos, ARRAY_SIZE(bos));
+      pthread_mutex_unlock(&q->lock);
+      for (unsigned i = 0; i < n; i++)
+         kbase_kmod_bo_free_now(bos[i]);
+      if (n < ARRAY_SIZE(bos))
+         break;
+   }
+}
+
