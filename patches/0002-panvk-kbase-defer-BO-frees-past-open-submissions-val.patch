+/* PANVK_VALIDATE=1: before a batch goes to the GPU, check that every address
+ * its jobs point at (shader, renderer state, tables, texture surfaces, UBOs,
+ * attribute buffers, indices) lies inside a live BO, and log the first ones
+ * that do not. kbase kills the job chain on such an access. */
+#if PAN_ARCH <= 7
+static unsigned panvk_validate_reports;
+
+static void
+panvk_validate_addr(const char *what, unsigned job, unsigned idx, uint64_t va, uint64_t size)
+{
+   if (!va || panvk_validate_reports >= 64)
+      return;
+   if (kbase_kmod_va_check(va, MAX2(size, 1)) != 0)
+      return;
+   panvk_validate_reports++;
+   mesa_loge("panvk validate: job %u %s[%u] = 0x%" PRIx64 " (+0x%" PRIx64 ") is not in a live BO",
+             job, what, idx, va, size);
+}
+
+static void
+panvk_validate_draw(unsigned job, const void *draw_desc)
+{
+   pan_unpack((const struct mali_draw_packed *)draw_desc, DRAW, d);
+
+   panvk_validate_addr("state", job, 0, d.state, pan_size(RENDERER_STATE));
+   panvk_validate_addr("tls", job, 0, d.thread_storage, pan_size(LOCAL_STORAGE));
+   panvk_validate_addr("push", job, 0, d.push_uniforms, 4);
+   if (!d.state || kbase_kmod_va_check(d.state, pan_size(RENDERER_STATE)) != 1)
+      return;
+
+   pan_unpack((const struct mali_renderer_state_packed *)(uintptr_t)d.state, RENDERER_STATE, rsd);
+   panvk_validate_addr("shader", job, 0, rsd.shader.shader & ~0xfull, 16);
+
+   if (rsd.shader.texture_count && d.textures) {
+      panvk_validate_addr("textures", job, 0, d.textures,
+                          rsd.shader.texture_count * pan_size(TEXTURE));
+      if (kbase_kmod_va_check(d.textures, rsd.shader.texture_count * pan_size(TEXTURE)) == 1) {
+         for (unsigned i = 0; i < rsd.shader.texture_count; i++) {
+            const struct mali_texture_packed *t =
+               (const void *)(uintptr_t)(d.textures + i * pan_size(TEXTURE));
+            pan_unpack(t, TEXTURE, tex);
+            panvk_validate_addr("tex.surfaces", job, i, tex.surfaces, pan_size(SURFACE_WITH_STRIDE));
+            if (tex.surfaces &&
+                kbase_kmod_va_check(tex.surfaces, pan_size(SURFACE_WITH_STRIDE)) == 1) {
+               pan_unpack((const struct mali_surface_with_stride_packed *)(uintptr_t)tex.surfaces,
+                          SURFACE_WITH_STRIDE, surf);
+               panvk_validate_addr("tex.surface0", job, i, surf.pointer, 1);
+            }
+         }
+      }
+   }
+
+   unsigned ubo_count = rsd.properties.uniform_buffer_count;
+   if (ubo_count && d.uniform_buffers) {
+      panvk_validate_addr("ubos", job, 0, d.uniform_buffers, ubo_count * pan_size(UNIFORM_BUFFER));
+      if (kbase_kmod_va_check(d.uniform_buffers, ubo_count * pan_size(UNIFORM_BUFFER)) == 1) {
+         for (unsigned i = 0; i < ubo_count; i++) {
+            pan_unpack((const struct mali_uniform_buffer_packed *)(uintptr_t)(
+                          d.uniform_buffers + i * pan_size(UNIFORM_BUFFER)),
+                       UNIFORM_BUFFER, ubo);
+            panvk_validate_addr("ubo", job, i, ubo.pointer, ubo.entries * 16);
+         }
+      }
+   }
+
+   unsigned attr_count = rsd.shader.attribute_count;
+   if (attr_count && d.attributes && d.attribute_buffers &&
+       kbase_kmod_va_check(d.attributes, attr_count * pan_size(ATTRIBUTE)) == 1) {
+      for (unsigned i = 0; i < attr_count; i++) {
+         pan_unpack((const struct mali_attribute_packed *)(uintptr_t)(
+                       d.attributes + i * pan_size(ATTRIBUTE)),
+                    ATTRIBUTE, attr);
+         uint64_t bva = d.attribute_buffers + attr.buffer_index * pan_size(ATTRIBUTE_BUFFER);
+         if (kbase_kmod_va_check(bva, pan_size(ATTRIBUTE_BUFFER)) != 1) {
+            panvk_validate_addr("attrib_buf_desc", job, i, bva, pan_size(ATTRIBUTE_BUFFER));
+            continue;
+         }
+         pan_unpack((const struct mali_attribute_buffer_packed *)(uintptr_t)bva, ATTRIBUTE_BUFFER, ab);
+         if (ab.type != MALI_ATTRIBUTE_TYPE_CONTINUATION && ab.size)
+            panvk_validate_addr("attrib_buf", job, i, ab.pointer, 1);
+      }
+   }
+}
+
+#endif
+
+static void
+panvk_validate_batch(struct panvk_batch *batch)
+{
+#if PAN_ARCH <= 7
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("PANVK_VALIDATE") != NULL;
+   if (!enabled)
+      return;
+
+   unsigned k = 0;
+   util_dynarray_foreach(&batch->jobs, void *, jobp) {
+      const uint8_t *job = *jobp;
+      const uint32_t *w = (const uint32_t *)job;
+      unsigned type = (w[4] >> 1) & 0x7f;
+      switch (type) {
+      case MALI_JOB_TYPE_COMPUTE:
+      case MALI_JOB_TYPE_VERTEX:
+         panvk_validate_draw(k, pan_section_ptr(job, COMPUTE_JOB, DRAW));
+         break;
+      case MALI_JOB_TYPE_TILER: {
+         pan_section_unpack(job, TILER_JOB, PRIMITIVE, prim);
+         panvk_validate_addr("indices", k, 0, prim.indices, 1);
+         panvk_validate_draw(k, pan_section_ptr(job, TILER_JOB, DRAW));
+         break;
+      }
+#if PAN_ARCH >= 6
+      case MALI_JOB_TYPE_INDEXED_VERTEX: {
+         pan_section_unpack(job, INDEXED_VERTEX_JOB, PRIMITIVE, prim);
+         panvk_validate_addr("indices", k, 0, prim.indices, 1);
+         panvk_validate_draw(k, pan_section_ptr(job, INDEXED_VERTEX_JOB, VERTEX_DRAW));
+         panvk_validate_draw(k, pan_section_ptr(job, INDEXED_VERTEX_JOB, FRAGMENT_DRAW));
+         break;
+      }
+#endif
+      default:
+         break;
+      }
+      k++;
+   }
+#endif
+}
