+/* The last BO frees, so a GPU page fault on an unmapped address (only in the
+ * kernel log) can be matched to the allocation that was released and to who
+ * released it. */
+#include <dlfcn.h>
+#include <time.h>
+#include <unwind.h>
+
+#define KBASE_FREE_RING 65536
+#define KBASE_FREE_FRAMES 8
+
+struct kbase_free_rec {
+   uint64_t va, size;
+   int64_t ns;
+   uintptr_t pc[KBASE_FREE_FRAMES];
+   uintptr_t alloc_pc[KBASE_FREE_FRAMES];
+};
+
+static struct kbase_free_rec kbase_free_ring[KBASE_FREE_RING];
+static uint32_t kbase_free_next;
+
+struct kbase_unwind_state {
+   uintptr_t *pc;
+   unsigned n, max;
+};
+
+static _Unwind_Reason_Code
+kbase_unwind_cb(struct _Unwind_Context *ctx, void *arg)
+{
+   struct kbase_unwind_state *st = arg;
+   uintptr_t pc = _Unwind_GetIP(ctx);
+   if (pc && st->n < st->max)
+      st->pc[st->n++] = pc;
+   return st->n < st->max ? _URC_NO_REASON : _URC_END_OF_STACK;
+}
+
+static bool kbase_live_enabled(void);
+
+static void
+kbase_record_free(uint64_t va, uint64_t size, const uintptr_t *alloc_pc)
+{
+   if (!kbase_live_enabled())
+      return;
+   uint32_t i = p_atomic_inc_return(&kbase_free_next) % KBASE_FREE_RING;
+   struct kbase_free_rec *r = &kbase_free_ring[i];
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   r->va = va;
+   r->size = size;
+   r->ns = ts.tv_sec * 1000000000ll + ts.tv_nsec;
+   memcpy(r->alloc_pc, alloc_pc, sizeof(r->alloc_pc));
+   memset(r->pc, 0, sizeof(r->pc));
+   struct kbase_unwind_state st = {.pc = r->pc, .max = KBASE_FREE_FRAMES};
+   _Unwind_Backtrace(kbase_unwind_cb, &st);
+}
+
+/* Once per process: /proc/self/maps (SAME_VA BOs show up at their GPU
+ * address) and the whole free ring, next to the driver, to match against a
+ * GPU page fault address from the kernel log. */
+void
+kbase_kmod_dump_maps_once(void)
+{
+   static bool done;
+   if (done)
+      return;
+   done = true;
+
+   Dl_info info;
+   if (!dladdr((void *)kbase_kmod_dump_maps_once, &info) || !info.dli_fname)
+      return;
+   char path[4096];
+   const char *slash = strrchr(info.dli_fname, '/');
+   snprintf(path, sizeof(path), "%.*s/fault-%d.txt",
+            slash ? (int)(slash - info.dli_fname) : 1, slash ? info.dli_fname : ".", getpid());
+   FILE *out = fopen(path, "w");
+   if (!out)
+      return;
+   FILE *maps = fopen("/proc/self/maps", "r");
+   char line[512];
+   while (maps && fgets(line, sizeof(line), maps)) {
+      fputs(line, out);
+   }
+   if (maps)
+      fclose(maps);
+   /* Pointers from GPU memory into big CPU-only anonymous mappings: a GPU
+    * page fault there means a descriptor holds a CPU address. */
+   struct { uint64_t lo, hi; bool gpu; } rg[4096];
+   unsigned nr = 0;
+   maps = fopen("/proc/self/maps", "r");
+   while (maps && nr < ARRAY_SIZE(rg) && fgets(line, sizeof(line), maps)) {
+      unsigned long long lo, hi;
+      char perms[5];
+      if (sscanf(line, "%llx-%llx %4s", &lo, &hi, perms) != 3)
+         continue;
+      bool mali = strstr(line, "mali") != NULL;
+      bool anon_big = !mali && !strchr(line, '/') && !strchr(line, '[') && hi - lo >= (64ull << 20);
+      if ((mali && perms[0] == 'r' && hi - lo < (64ull << 20)) || anon_big) {
+         rg[nr].lo = lo;
+         rg[nr].hi = hi;
+         rg[nr].gpu = mali;
+         nr++;
+      }
+   }
+   if (maps)
+      fclose(maps);
+   unsigned hits = 0;
+   for (unsigned i = 0; i < nr && hits < 200; i++) {
+      if (!rg[i].gpu)
+         continue;
+      const uint64_t *w = (const uint64_t *)(uintptr_t)rg[i].lo;
+      for (uint64_t k = 0; k < (rg[i].hi - rg[i].lo) / 8 && hits < 200; k++) {
+         uint64_t v = w[k] & ~0x3full;
+         if (v < 0x1000000000ull || v >= 0x8000000000ull)
+            continue;
+         for (unsigned j = 0; j < nr; j++) {
+            if (!rg[j].gpu && v >= rg[j].lo && v < rg[j].hi) {
+               uint64_t at = rg[i].lo + k * 8;
+               fprintf(out, "cpuptr %" PRIx64 " at %" PRIx64 " (region %" PRIx64 "+%" PRIx64 "):",
+                       w[k], at, rg[i].lo, at - rg[i].lo);
+               for (int d = -4; d < 8; d++) {
+                  if ((int64_t)k + d >= 0 && (k + d) * 8 < rg[i].hi - rg[i].lo)
+                     fprintf(out, " %016" PRIx64, w[k + d]);
+               }
+               fputc('\n', out);
+               hits++;
+               break;
+            }
+         }
+      }
+   }
+
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   int64_t now = ts.tv_sec * 1000000000ll + ts.tv_nsec;
+   for (unsigned k = 0; k < KBASE_FREE_RING; k++) {
+      const struct kbase_free_rec *r = &kbase_free_ring[k];
+      if (!r->size)
+         continue;
+      fprintf(out, "freed %" PRIx64 "-%" PRIx64 " %.3fs", r->va, r->va + r->size,
+              (now - r->ns) / 1e9);
+      for (unsigned f = 0; f < KBASE_FREE_FRAMES && r->pc[f]; f++) {
+         Dl_info fi;
+         if (dladdr((void *)r->pc[f], &fi) && fi.dli_fbase) {
+            const char *n = fi.dli_fname ? strrchr(fi.dli_fname, '/') : NULL;
+            fprintf(out, " %s+0x%" PRIxPTR, n ? n + 1 : "?", r->pc[f] - (uintptr_t)fi.dli_fbase);
+         }
+      }
+      fputs(" | alloc:", out);
+      for (unsigned f = 0; f < KBASE_FREE_FRAMES && r->alloc_pc[f]; f++) {
+         Dl_info fi;
+         if (dladdr((void *)r->alloc_pc[f], &fi) && fi.dli_fbase) {
+            const char *n = fi.dli_fname ? strrchr(fi.dli_fname, '/') : NULL;
+            fprintf(out, " %s+0x%" PRIxPTR, n ? n + 1 : "?", r->alloc_pc[f] - (uintptr_t)fi.dli_fbase);
+         }
+      }
+      fputc('\n', out);
+   }
+   fclose(out);
+   mesa_loge("kbase: wrote %s", path);
+}
+
+void
+kbase_kmod_dump_recent_frees(uint64_t lo, uint64_t hi)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   int64_t now = ts.tv_sec * 1000000000ll + ts.tv_nsec;
+   unsigned printed = 0;
+   for (unsigned k = 0; k < KBASE_FREE_RING && printed < 64; k++) {
+      const struct kbase_free_rec *r = &kbase_free_ring[k];
+      if (!r->size || r->va + r->size <= lo || r->va >= hi || now - r->ns > 3000000000ll)
+         continue;
+      char bt[512] = {0};
+      size_t off = 0;
+      for (unsigned f = 0; f < KBASE_FREE_FRAMES && r->pc[f]; f++) {
+         Dl_info info;
+         if (dladdr((void *)r->pc[f], &info) && info.dli_fbase) {
+            const char *name = info.dli_fname ? strrchr(info.dli_fname, '/') : NULL;
+            off += snprintf(bt + off, sizeof(bt) - off, " %s+0x%" PRIxPTR,
+                            name ? name + 1 : "?", r->pc[f] - (uintptr_t)info.dli_fbase);
+         }
+         if (off >= sizeof(bt))
+            break;
+      }
+      mesa_loge("kbase: freed 0x%" PRIx64 "-0x%" PRIx64 " %.3f s ago:%s", r->va,
+                r->va + r->size, (now - r->ns) / 1e9, bt);
+      printed++;
+   }
+}
+
+/* PANVK_VALIDATE: the live BO ranges, sorted by address, so the queue can
+ * check every GPU address it is about to hand the hardware. */
+struct kbase_live_range {
+   uint64_t lo, hi;
+};
+static struct {
+   pthread_mutex_t lock;
+   struct kbase_live_range *r;
+   unsigned n, max;
+   int enabled; /* -1 unknown */
+} kbase_live = {PTHREAD_MUTEX_INITIALIZER, NULL, 0, 0, -1};
+
+static bool
+kbase_live_enabled(void)
+{
+   if (kbase_live.enabled < 0)
+      kbase_live.enabled = getenv("PANVK_VALIDATE") != NULL;
+   return kbase_live.enabled;
+}
+
+static unsigned
+kbase_live_lower_bound(uint64_t va)
+{
+   unsigned lo = 0, hi = kbase_live.n;
+   while (lo < hi) {
+      unsigned mid = (lo + hi) / 2;
+      if (kbase_live.r[mid].lo < va)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   return lo;
+}
+
+static void
+kbase_live_add(uint64_t va, uint64_t size)
+{
+   if (!kbase_live_enabled() || !va)
+      return;
+   pthread_mutex_lock(&kbase_live.lock);
+   if (kbase_live.n == kbase_live.max) {
+      unsigned max = MAX2(1024, kbase_live.max * 2);
+      void *r = realloc(kbase_live.r, max * sizeof(*kbase_live.r));
+      if (!r) {
+         pthread_mutex_unlock(&kbase_live.lock);
+         return;
+      }
+      kbase_live.r = r;
+      kbase_live.max = max;
+   }
+   unsigned i = kbase_live_lower_bound(va);
+   memmove(&kbase_live.r[i + 1], &kbase_live.r[i], (kbase_live.n - i) * sizeof(*kbase_live.r));
+   kbase_live.r[i] = (struct kbase_live_range){va, va + size};
+   kbase_live.n++;
+   pthread_mutex_unlock(&kbase_live.lock);
+}
+
+static void
+kbase_live_remove(uint64_t va)
+{
+   if (!kbase_live_enabled() || !va)
+      return;
+   pthread_mutex_lock(&kbase_live.lock);
+   unsigned i = kbase_live_lower_bound(va);
+   if (i < kbase_live.n && kbase_live.r[i].lo == va) {
+      memmove(&kbase_live.r[i], &kbase_live.r[i + 1],
+              (kbase_live.n - i - 1) * sizeof(*kbase_live.r));
+      kbase_live.n--;
+   }
+   pthread_mutex_unlock(&kbase_live.lock);
+}
+
+/* 1: [va, va + size) is inside a live BO. 0: it is not. -1: not tracking. */
+int
+kbase_kmod_va_check(uint64_t va, uint64_t size)
+{
+   if (!kbase_live_enabled())
+      return -1;
+   pthread_mutex_lock(&kbase_live.lock);
+   unsigned i = kbase_live_lower_bound(va + 1);
+   bool ok = i > 0 && kbase_live.r[i - 1].lo <= va && va + size <= kbase_live.r[i - 1].hi;
+   pthread_mutex_unlock(&kbase_live.lock);
+   return ok;
+}
+
 static struct pan_kmod_bo *
