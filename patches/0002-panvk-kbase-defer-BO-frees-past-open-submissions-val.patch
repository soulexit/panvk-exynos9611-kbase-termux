                     uint32_t flags)
@@ -633,10 +917,16 @@ kbase_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
       return NULL;
 
    const uint64_t pages = DIV_ROUND_UP(size, 4096);
+   /* PANVK_KBASE_GROW_COMMIT_MB: pages a grow-on-fault BO starts with. */
+   static int64_t grow_initial = -1;
+   if (grow_initial < 0) {
+      const char *mb = getenv("PANVK_KBASE_GROW_COMMIT_MB");
+      grow_initial = mb ? strtoull(mb, NULL, 0) * 256 : KBASE_GROW_INITIAL_PAGES;
+   }
    union kbase_ioctl_mem_alloc req = {
       .in = {
          .va_pages = pages,
-         .commit_pages = grow ? MIN2(pages, KBASE_GROW_INITIAL_PAGES) : pages,
+         .commit_pages = grow ? MIN2(pages, (uint64_t)grow_initial) : pages,
          .extension = grow ? KBASE_GROW_STEP_PAGES : 0,
          .flags = exec ? KBASE_MEM_FLAGS_EXEC
                        : KBASE_MEM_FLAGS_RW | (grow ? BASE_MEM_GROW_ON_GPF : 0) |
@@ -688,16 +978,25 @@ kbase_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
       bo->gpu_va = (uint64_t)(uintptr_t)anchor;
    }
 
+   memset(bo->alloc_pc, 0, sizeof(bo->alloc_pc));
+   if (kbase_live_enabled()) {
